    "criteria": {
      "C1_ban_shallow_competence": {
        "statement": "the ban arm declares the correct terminal on at least 2 of 3 of B_L8_j1, B_L8_j2, B_L8_j8",
        "threshold": "2/3"
      },
      "C2_none_controls_honest": {
        "statement": "at least 9 of the 10 NONE-gold calls declare NONE, and no NONE-gold call declares an entity name from its own item",
        "threshold": "9/10 and 0 name-on-NONE"
      },
      "C3_matched_deep": {
        "statement": "correct deliveries over the three matched deep pairs (j = 32 on L32A, j = 32 and j = 48 on L48), free against ban",
        "threshold": "reported as a 3/3 pair, no band"
      },
      "C4_cost_law": {
        "statement": "least-squares slope of completion tokens against j on the four L48 depth rungs, per arm; growth if slope >= 10 tokens per hop (one fifth of round 6's 80 tokens per hop free-writing law)",
        "threshold": "10 tokens/hop"
      },
      "C5_self_agreement": {
        "statement": "both re-dispatch pairs agree on the declared name and on tokens",
        "threshold": "2/2"
      },
      "C6_trace_provenance": {
        "statement": "among undelivered name-gold records, gold-terminal-in-trace minus pseudo-gold-in-trace is at least 0.50, else the trace readout is refused",
        "threshold": "0.50"
      }
    },
    "dispatch": {
      "archived_k48_certification": {
        "seed": 116261051,
        "yesno_digest16": "068bc6a1fb0620fb"
      },
      "call_cap": 40,
      "dispatch_budget_s": 1500,
      "growth_tokens_per_hop": 10.0,
      "max_tokens_cap": 2048,
      "planned_calls": 36,
      "temperature": 0.0
    },
    "question": "On one load-floor ladder item, with the fact block fixed and only the step count j and the output permission moved, does banning the written traversal (a) collapse terminal-name accuracy, (b) preserve it at a token cost that still grows with depth, or (c) preserve it at flat cost?",
    "schema": "round60-gate-v1",
    "tier_rule": "controls_invalid if C2 fails; else ban_not_followed if the ban arm's mean visible answer length is at least half the free arm's on matched in-band cells; else no_ceiling_both_modes if both arms deliver at least 2 of 3 deep; else internalized_flat_cost if the ban arm delivers at least 2 of 3 deep, the free arm at most 1 of 3, and the ban arm's C4 slope is below 10 tokens per hop; else cost_migrated_to_hidden_channel on the same delivery split with a C4 slope at or above 10; else externalized_chain_required if the free arm delivers at least 2 of 3 and the ban arm at most 1 of 3; else unresolved"
  }
